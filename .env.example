# Copy to .env (used by docker compose) or set these in your shell before `npm start`.
HTTPS_PORT=8443
HTTP_PORT=8080
# Extra hostnames/IPs for the self-signed cert, e.g. your PC's LAN IP when running in Docker.
PUBLIC_HOSTS=
# Metres two players must be within to connect.
CONNECT_DISTANCE=3
# Seconds a UNO player has to move before they automatically draw.
UNO_TURN_SECONDS=60
# Only enable on a real domain with a trusted certificate.
ENABLE_HSTS=false
